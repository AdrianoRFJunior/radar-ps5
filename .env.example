# ============================================================================
# RADAR BF 2026 - CONFIGURAÇÃO DE AMBIENTE (.env.example)
# Copie este arquivo para .env na raiz do projeto caso deseje customizar.
# ============================================================================

# --- BANCO DE DADOS ---
# Por padrão utiliza SQLite local. Para migrar para PostgreSQL no futuro,
# basta alterar para: postgresql+psycopg2://usuario:senha@localhost:5432/radar_bf2026
DATABASE_URL=sqlite:///./radar_bf2026.db

# --- FUSO HORÁRIO ---
TIMEZONE=America/Sao_Paulo

# --- AGENDADOR DE MONITORAMENTO AUTOMÁTICO ---
# Modos: NORMAL (30 min), HIGH_ACTIVITY (10 min), NIGHT (60 min)
SCHEDULER_DEFAULT_MODE=NORMAL
SCHEDULER_INTERVAL_NORMAL_MINUTES=30
SCHEDULER_INTERVAL_HIGH_MINUTES=10
SCHEDULER_INTERVAL_NIGHT_MINUTES=60
SCHEDULER_AUTO_START=true

# --- CREDENCIAIS OPCIONAIS DE APIS OFICIAIS ---
# Caso possua credenciais oficiais de afiliado/parceiro das lojas, preencha abaixo.
# Sem essas chaves, os conectores utilizam endpoints públicos permitidos ou
# reportam claramente o status de indisponibilidade/necessidade de credencial.
MERCADOLIVRE_ACCESS_TOKEN=
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
LOMADEE_APP_TOKEN=
LOMADEE_SOURCE_ID=

# --- LIMITES DE REQUISIÇÃO E TIMEOUTS ---
COLLECTOR_TIMEOUT_SECONDS=15
COLLECTOR_MIN_DELAY_SECONDS=2.0
USER_AGENT=RadarBF2026-PriceMonitor/1.0 (Academic & Personal Price Analytics; +http://localhost:5173)
